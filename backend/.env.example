# Copy this file to backend/.env and fill in your keys. backend/.env is gitignored.
#
# ONE key is required. Adding a second or third is optional: they are fallbacks.
# Every LLM call goes to ONE provider, the first one set in this order:
#   OpenAI -> Anthropic -> Google
# If that provider's call fails (bad key, rate limit, outage), the next one you set takes over.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Embeddings follow the same order: OpenAI, then Gemini. Anthropic has no embedding API, so with only
# an Anthropic key a small local model is used (downloaded once, about 80 MB).
# Changing which key provides embeddings means re-indexing your profile (Re-index in the app).

# Optional
# LLM_PROVIDER=anthropic          # put this provider first: openai | anthropic | google
# EMBED_PROVIDER=local            # force embeddings: openai | google | local
# OPENAI_MODEL=openai/gpt-5.4
# ANTHROPIC_MODEL=anthropic/claude-sonnet-5-5
# GEMINI_MODEL=gemini/gemini-2.5-pro
# RAG_API_PORT=8710
# RAG_BROWSER=/path/to/chrome-or-edge
# RAG_DATA_DIR=/somewhere/else
